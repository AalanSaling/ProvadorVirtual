# Backend Configuration
PORT=3000
NODE_ENV=development
BACKEND_PUBLIC_URL=http://localhost:3000

# Supabase Admin Configuration (REQUIRED - SERVER SIDE ONLY)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# AI Providers Configuration
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image
GOOGLE_API_KEY=your-google-api-key
PERFECTCORP_API_KEY=your-perfectcorp-api-key
PERFECTCORP_API_HOST=https://s2s.perfectcorp.com

# System Storage Retention (TTL in days)
TRY_ON_RESULTS_TTL_DAYS=7

# Mobile App Public Configuration (Safe for client)
EXPO_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
