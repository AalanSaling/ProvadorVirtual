{
  "name": "provador-virtual-app",
  "private": true,
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "dev:server": "tsx server.ts",
    "build:web": "npx expo export -p web --output-dir dist-web",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start:server": "node dist/server.cjs",
    "dev": "tsx server.ts",
    "build": "npx expo export -p web --output-dir dist-web && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "test": "tsx server/tests/phase1.test.ts && tsx server/tests/phase2a_perfectcorp.test.ts && tsx server/tests/phase4_semantic_pipeline.test.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-navigation/bottom-tabs": "^7.18.16",
    "@react-navigation/native": "^7.3.16",
    "@supabase/supabase-js": "^2.112.3",
    "dotenv": "^17.2.3",
    "expo": "^57.0.12",
    "expo-camera": "^57.0.3",
    "expo-file-system": "^18.0.11",
    "expo-image-manipulator": "^57.0.9",
    "expo-image-picker": "^57.0.9",
    "expo-secure-store": "^57.0.1",
    "express": "^4.21.2",
    "lucide-react-native": "^1.31.0",
    "react": "^19.0.1",
    "react-dom": "19.2.8",
    "react-native": "^0.87.0",
    "react-native-safe-area-context": "^5.9.0",
    "react-native-screens": "^4.27.0",
    "react-native-svg": "^15.15.5",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-native": "^0.73.0",
    "esbuild": "^0.25.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
